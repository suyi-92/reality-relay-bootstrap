# reality-relay-bootstrap VLESS+Reality 示例配置
# 使用方法：cp config.example.env config.env && nano config.env
# 不要把 config.env、home-proxies.csv、Reality 私钥、UUID、节点输出文件提交到公开仓库。

SERVER_ALIAS="my-vps"
SERVER_IP=""
SERVER_IP_IPV4=""
SERVER_IP_IPV6=""
SSH_PORT="22"
INITIAL_USER="root"
ADMIN_USER="admin"
ADMIN_PUBKEY=""
# 可选：分步骤运行时如需多个 admin 公钥，也可以把额外公钥逐行写入 ADMIN_PUBKEYS。
# 示例：ADMIN_PUBKEYS=$'ssh-ed25519 AAAA... user1\nssh-ed25519 BBBB... user2'
ADMIN_PUBKEYS=""
ENABLE_SFTP_USER="false"
SFTP_USER="sftpuser"
USE_233BOY_INSTALLER="false"
INSTALL_SINGBOX_METHOD="apt"
MODE_443="direct"
DIRECT_PORT="443"
HOME_PORT_START="51043"
HOME_PORT_END="51060"
ENABLE_UFW="true"
ENABLE_FAIL2BAN="true"
ENABLE_IPV6_LISTEN="false"

# 额外可选项；默认安全保守。
ADMIN_SUDO_NOPASSWD="true"
SFTP_PUBKEY=""
CSV_PATH="./home-proxies.csv"
RRB_STATE_DIR="/etc/reality-relay-bootstrap"
SINGBOX_CONFIG_PATH="/etc/sing-box/config.json"

# 入站协议固定为 VLESS + Reality。
PROXY_PROTOCOL="vless-reality"
# 代理出站/DNS IP 版本：ipv4、ipv6、dual。默认 ipv4；dual 表示双栈并优先 IPv4。
PROXY_IP_VERSION="ipv4"
# true 会重新生成 VLESS UUID、Reality keypair 和 short-id；默认 false，重复部署不会让旧节点失效。
RESET_PROXY_KEYS="false"
VLESS_UUID_PATH="/etc/reality-relay-bootstrap/vless-uuid.txt"
VLESS_FLOW="xtls-rprx-vision"
REALITY_PRIVATE_KEY_PATH="/etc/reality-relay-bootstrap/reality-private.key"
REALITY_PUBLIC_KEY_PATH="/etc/reality-relay-bootstrap/reality-public.key"
REALITY_SHORT_ID_PATH="/etc/reality-relay-bootstrap/reality-short-id.txt"
REALITY_SERVER_NAME="www.microsoft.com"
REALITY_HANDSHAKE_SERVER="www.microsoft.com"
REALITY_HANDSHAKE_PORT="443"
REALITY_MAX_TIME_DIFFERENCE="1m"

# MODE_443=smart 时为空表示使用 CSV 第一行家宽出口。
SMART_AI_HOME_TAG=""
REJECT_CN_PRIVATE="true"

# 客户端节点输出参数。
CLIENT_FINGERPRINT="chrome"
CLIENT_UDP="false"
CLIENT_ALPN="h2,http/1.1"
CLASH_MIXED_PORT="7890"

# 可选：独立订阅端口。内置 HTTP 文件服务使用 VLESS UUID 作为订阅 token；仍建议用服务商安全组限制访问来源。
ENABLE_SUBSCRIPTION_SERVER="false"
SUBSCRIPTION_PORT="51040"
# 可选：mihomo、v2ray、shadowsocks、ssr、quantumultx、shadowrocket；默认只生成 Mihomo。
SUBSCRIPTION_TARGET="mihomo"
SUBSCRIPTION_DIR="/etc/reality-relay-bootstrap/subscription"
